{
  "name": "quick-lookup",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Instant, evidence-backed lookup for selected text.",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --test 'src/**/*.test.ts' 'bridge/**/*.test.mjs'",
    "check": "npm run typecheck && npm test && npm run build",
    "smoke": "node tools/live-check.ts",
    "sweep": "node tools/relevance-sweep.ts",
    "unused": "node tools/unused.mjs",
    "e2e": "npm run build && node tools/e2e.ts",
    "preview": "esbuild tools/card-preview.ts --bundle --outfile=dist/preview/preview.js --format=iife --target=chrome116 && cp tools/preview/index.html dist/preview/index.html"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.273",
    "@types/node": "^22.5.4",
    "esbuild": "^0.21.5",
    "playwright": "^1.62.1",
    "typescript": "^5.5.4"
  }
}
