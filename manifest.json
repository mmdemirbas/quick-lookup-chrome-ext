{
  "manifest_version": 3,
  "name": "Quick Lookup",
  "version": "0.1.0",
  "description": "Instant lookup of selected text with a movable popup.",
  "permissions": [
    "storage",
    "contextMenus",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://*.wikipedia.org/*",
    "https://www.wikidata.org/*",
    "https://upload.wikimedia.org/*",
    "https://api.dictionaryapi.dev/*",
    "https://translate.google.com/*",
    "https://www.deepl.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Quick Lookup",
    "default_popup": "src/action/index.html"
  },
  "options_ui": {
    "page": "src/options/index.html",
    "open_in_tab": false
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}